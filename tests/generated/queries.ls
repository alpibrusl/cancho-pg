pub fn add_user_partial[&h, &c, &a1, &a3](heap: &!h Heap, conn: &!c Conn, name: &a1 [byte], age: int, age_given: bool, nickname: &a3 [byte], nickname_given: bool) -> [heap, conn_read, conn_write] (buffer.Buffer, int) {
